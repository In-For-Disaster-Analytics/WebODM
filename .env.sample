# Tapis OAuth2 Configuration
WO_TAPIS_BASE_URL=https://portals.tapis.io
WO_TAPIS_TENANT_ID=portals
WO_TAPIS_CLIENT_SECRET=
# WebODM Configuration
# WebODM Configuration
WO_HOST=webodm.tacc.utexas.edu
WO_PORT=8000              # or whatever you actually expose
WO_TAPIS_CALLBACK_URL=https://webodm.tacc.utexas.edu/api/oauth2/tapis/callback
WO_CLUSTERODM_URL=https://clusterodm.tacc.utexas.edu
WO_MEDIA_DIR=/corral/webodm/media
WO_SHARED_VOLUME_ROOT=/corral/webodm/media
WO_CORRAL_GROUP=G-820466
WO_CORRAL_GROUP_ID=820466
# Corral service account the webapp/worker step down to (via gosu) for media writes,
# so files are owned by this account instead of "nobody" on the root-squashed NFS mount.
# IMPORTANT: use the NUMERIC uid:gid, not a name -- gosu resolves the user against the
# CONTAINER's /etc/passwd, and TACC LDAP accounts (e.g. tasclient_dsso) are not in it.
# The gid should be the corral allocation group (WO_CORRAL_GROUP_ID). Find them on the
# host with: id -u tasclient_dsso  /  the allocation gid. Leave EMPTY to keep the legacy
# behavior (processes run as root -> files owned by nobody).
# Requires an image rebuild (./webodm.sh update) so gosu is present.
# See docs/design/2026-07-01-corral-ownership-group-inheritance.md
WO_RUN_AS_USER=897053:829114
WO_DB_DIR=/db
WO_SSL=NO
WO_SSL_KEY=
WO_SSL_CERT=
WO_SSL_INSECURE_PORT_REDIRECT=80
WO_DEBUG=NO
WO_DEV=NO
WO_BROKER=redis://broker
WO_DEFAULT_NODES=1
WO_SETTINGS=
WO_TAS_URL=https://tas.tacc.utexas.edu/api
WO_TAS_SERVICE_USERNAME=<tas-service-username>
WO_TAS_SERVICE_PASSWORD=<tas-service-password>
WO_TAS_RESOURCE_FILTER=LS6,Lonestar6,lonestar6
WO_TAS_DEFAULT_ALLOCATION=PT2050-DataX
# Allocation-based access control. Comma-separated list of TAS charge codes
# allowed to create projects, upload imagery, and run jobs. Leave empty to
# disable the gate (any authenticated user allowed). Superusers always bypass.
WO_TAS_REQUIRED_ALLOCATIONS=PT2050-DataX
# Seconds to cache a user's allocation lookup (avoids hammering TAS on uploads).
# Leave empty to default to the sign-in (JWT) token lifetime (6h).
WO_TAS_ALLOCATION_CACHE_SECONDS=

# DSO Agent API — CKAN publishing via dso-agent-api + Tapis OAuth2 (coreplugins/ckan).
# Feature is inactive unless WO_DSO_AGENT_URL is set.
WO_DSO_AGENT_URL=https://dsoagentapi.pods.portals.tapis.io
# Externally reachable base URL for WebODM (used to build CKAN resource links).
WO_URL=https://webodm.tacc.utexas.edu

# Label Studio integration (coreplugins/embeddings) — self-hosted Label Studio
# Pod, e.g. https://labelstudio.pods.portals.tapis.io (see label-studio-tapis-auth).
# Feature is inactive unless WO_LABEL_STUDIO_URL is set.
WO_LABEL_STUDIO_URL=
# Label Studio's OWN Personal Access Token (sent as `Authorization: Bearer`),
# generated once by an admin inside the Label Studio instance itself — NOT a
# Tapis JWT (see docs/design/2026-07-22-geospatial-embeddings-classification.md,
# Decision 32). Used only for label_studio_client.py's server-to-server API
# calls (project create/import/webhook-register); never sent to the browser.
WO_LABEL_STUDIO_API_TOKEN=
# Shared secret verifying inbound ANNOTATION_CREATED/UPDATED webhook calls from
# Label Studio at /api/plugins/embeddings/labelstudio-webhook.
WO_LABELSTUDIO_WEBHOOK_SECRET=

# embeddingsdb — Postgres+PostGIS+pgvector Tapis Pod (coreplugins/embeddings),
# a SEPARATE Postgres instance from WebODM's own database (zero WebODM-database
# schema changes). Feature is inactive unless WO_EMBEDDINGS_DB_URL is set.
WO_EMBEDDINGS_DB_URL=

# model-train's Tapis Actor ID (coreplugins/embeddings) — overridable
# per-deployment; has a working default in webodm/settings.py if left unset.
WO_MODEL_ACTOR_ID=

# embed-generate's Tapis App (coreplugins/embeddings) — Decision 45: runs as
# a Tapis Job on TACC's ls6, not an Actor (Abaco's worker pool can't
# provision for this workload's image size on this tenant). Both have
# working defaults in webodm/settings.py if left unset here.
WO_EMBED_GENERATE_APP_ID=
WO_EMBED_GENERATE_APP_VERSION=

# MLflow Pod tracking URI (coreplugins/embeddings) — used by the diagnostics-proxy
# endpoint; model-train's own Actor config points its runtime at the same URI.
WO_MLFLOW_TRACKING_URI=

# DSO STAC API base URL (coreplugins/embeddings) — existing service, consumed
# read-only (browse/import) plus Tapis-JWT writes (publish/retract). Has a
# working default in webodm/settings.py if left unset here.
WO_STAC_API_URL=
